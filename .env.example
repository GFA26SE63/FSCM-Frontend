# Backend base URL (without /api/v1).
VITE_API_BASE_URL=https://localhost:7027
VITE_GRAPHQL_ENDPOINT=https://localhost:7027/graphql

# External identity is used only to sign in. The backend exchanges the provider ID token for an FSCM JWT.
# Google Identity Services (OAuth client type: Web application)
VITE_GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# VietMap (browser keys – restrict allowed domains in the VietMap console).
# Maps API key: Street Map tiles.
VITE_VIETMAP_MAPS_API_KEY=
# Services API key: address search, place details and reverse geocoding.
VITE_VIETMAP_SEARCH_API_KEY=
