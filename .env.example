# Backend base URL (without /api/v1). Ignored when VITE_USE_MOCK=true.
VITE_API_BASE_URL=http://localhost:5080
# true (default) = in-browser mock adapter with prototype seed data; false = call the real API.
VITE_USE_MOCK=true
# Microsoft Entra ID (placeholders – fill in when wiring MSAL against the real API)
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_API_SCOPE=api://fscm-api/access_as_user
VITE_ENTRA_REDIRECT_URI=http://localhost:5173/login
