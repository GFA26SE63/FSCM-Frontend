# Backend base URL (without /api/v1).
VITE_API_BASE_URL=http://localhost:5080
VITE_GRAPHQL_ENDPOINT=https://localhost:7027/graphql
# External identity is used only to sign in. The backend exchanges the provider ID token for an FSCM JWT.
# Microsoft Entra ID
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_REDIRECT_URI=http://localhost:5173/login

# Google Identity Services OAuth 2.0 Web client ID
VITE_GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
